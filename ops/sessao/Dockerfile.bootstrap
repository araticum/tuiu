# Imagem de BOOTSTRAP: o container ganha TELA (Xvfb + VNC + noVNC) só para o
# login humano acontecer DENTRO dele. A sessão nasce no container e fica no
# volume; nenhuma janela do operador fica aberta e nenhum arquivo trafega.
#
# Depois do bootstrap esta imagem não é mais usada: o loop roda headless na
# imagem normal, com a mesma sessão.

FROM mcr.microsoft.com/playwright/python:v1.59.0-noble

ENV PYTHONUNBUFFERED=1 \
    DISPLAY=:99 \
    SCREEN=1600x900x24

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
        xvfb x11vnc novnc websockify \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --break-system-packages \
        "playwright==1.59.0" "psycopg[binary]==3.3.3" cryptography

WORKDIR /app
COPY backend/app/ /app/backend/app/
COPY ingest/portal/ /app/ingest/portal/
COPY ops/sessao/bootstrap.sh /app/bootstrap.sh
RUN chmod +x /app/bootstrap.sh \
    && mkdir -p /app/data/sessao \
    && useradd -m -u 10001 leitor \
    && chown -R leitor:leitor /app

USER leitor
EXPOSE 6080
CMD ["/app/bootstrap.sh"]
